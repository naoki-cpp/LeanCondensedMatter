import LeanCondensedMatter.Analysis.PowerSeries.ExpLog
import LeanCondensedMatter.Permutation.ConnectedCycleSeries

set_option linter.style.header false

/-!
# ζ-weighted formal grand-partition series

The connected-cycle series already packages the arbitrary-`ζ` connected exchange coefficients.
This file takes its formal exponential once, before any fermion/boson specialization, so the formal
linked-cluster identity is shared by both statistics.

No analytic evaluation of the formal variable is involved.
-/

namespace Combinatorics

variable {ι : Type*} [Fintype ι]

/-- The formal grand-partition series generated by the `ζ`-weighted connected-cycle series. -/
noncomputable def permutationGrandPartitionSeries
    (ζ : ℂ) (K : Matrix ι ι ℂ) : PowerSeries ℂ :=
  PowerSeries.formalExp (permutationConnectedCycleSeries ζ K)

@[simp]
theorem constantCoeff_permutationGrandPartitionSeries
    (ζ : ℂ) (K : Matrix ι ι ℂ) :
    PowerSeries.constantCoeff (permutationGrandPartitionSeries ζ K) = 1 := by
  exact PowerSeries.constantCoeff_formalExp
    (constantCoeff_permutationConnectedCycleSeries ζ K)

/-- Formal linked-cluster identity: the logarithm of the `ζ`-weighted grand-partition series is the
connected-cycle series. This theorem is valid for arbitrary `ζ`, including `ζ = 0`. -/
theorem logOf_permutationGrandPartitionSeries
    (ζ : ℂ) (K : Matrix ι ι ℂ) :
    PowerSeries.logOf (permutationGrandPartitionSeries ζ K) =
      permutationConnectedCycleSeries ζ K := by
  exact PowerSeries.logOf_formalExp
    (constantCoeff_permutationConnectedCycleSeries ζ K)

end Combinatorics
