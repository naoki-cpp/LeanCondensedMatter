import LeanCondensedMatter.Analysis.Exponential
import LeanCondensedMatter.SecondQuantization.Common.Thermal.BlochDeDominicis.NormalizedTwoPointTrace
import LeanCondensedMatter.SecondQuantization.Bosonic.Thermal.BlochDeDominicis.FreeKMSRotation
import LeanCondensedMatter.SecondQuantization.Bosonic.Thermal.BlochDeDominicis.TwoPoint
import LeanCondensedMatter.SecondQuantization.Bosonic.Thermal.ConvergenceAwareGibbs
import LeanCondensedMatter.SecondQuantization.Bosonic.Thermal.BlochDeDominicis.OrderedProductSummable

set_option linter.style.header false
set_option linter.unusedFintypeInType false

/-!
# Concrete mixed free-boson Gibbs contractions

Under the standard positive one-mode Boltzmann exponent assumption, summability of the mixed product
`aᵢ aⱼ†` follows from the general finite ordered-product summability theorem on the infinite
occupation space. The Bose denominator is nonzero under the same positivity hypothesis. The reverse
contraction follows from the uniform free-field KMS rotation.
-/

namespace SecondQuantization
namespace Bosonic

noncomputable section

variable {Mode : Type*}

/-- File-local classical decidable equality for mode comparisons in the concrete contractions. -/
local instance instDecidableEqConcreteMixedTwoPoint : DecidableEq Mode := Classical.decEq Mode

variable [Fintype Mode]

/-- Grand-canonical annihilation/creation correlation for a finite-mode free
boson gas at chemical potential `μ`. The thermal generator has mode energies
`ξ i = ε i - μ`; positivity of `β * ξ i` gives a normalized Gibbs trace. -/
theorem grandCanonicalGibbsExpectation_annihilate_comp_create_concrete
    (ε : Mode → ℝ) (β μ : ℝ)
    (hpos : ∀ k, 0 < β * (ε k - μ)) (i j : Mode) :
    grandCanonicalGibbsExpectation ε β μ ((annihilate i).comp (create j)) =
      if i = j then
        (1 - Complex.exp (((-(ε i - μ) * β : ℝ) : ℂ)))⁻¹ else 0 := by
  let ξ : Mode → ℝ := fun k => ε k - μ
  change grandCanonicalGibbsExpectation ε β μ ((annihilate i).comp (create j)) =
    if i = j then (1 - Complex.exp (((-(ξ i) * β : ℝ) : ℂ)))⁻¹ else 0
  have hden : 1 - Complex.exp (((-(ξ i) * β : ℝ) : ℂ)) ≠ 0 :=
    sub_ne_zero.mpr (Ne.symm (Complex.exp_ne_one_of_re_ne_zero (by
      change -(ξ i) * β ≠ 0
      nlinarith [hpos i])))
  have hvalue :
      grandCanonicalGibbsExpectation ε β μ ((annihilate i).comp (create j)) =
        (if i = j then (1 : ℂ) else 0) /
          (1 - Complex.exp ((-(ξ i) * β : ℝ) : ℂ)) := by
    have hC1 : Common.heisenbergEvolve (freeEigenvalue ξ) (-β) (annihilate i) =
        Complex.exp ((-(ξ i) * (-β) : ℝ) : ℂ) • annihilate i := by
      have h := imaginaryTimeEvolve_annihilate ξ (-β) i
      rwa [show ((-(ξ i) * (-β) : ℝ) : ℂ) = -((-β : ℝ) : ℂ) * (ξ i : ℂ) by push_cast; ring]
    have hcomm : ScalarExchange.zetaCommutator (1 : ℂ) (annihilate i) (create j) =
        (if i = j then (1 : ℂ) else 0) •
          (LinearMap.id : FockSpace Mode →ₗ[ℂ] FockSpace Mode) := by
      simpa using comm_annihilate_create i j
    have hSummD := summable_imaginaryTimeEvolveFree_self ξ β hpos
    have hRotate :=
      summable_imaginaryTimeEvolveFree_comp_create_mul_annihilate ξ β hpos i j
    have hpartition : Common.tsumTrace
        (Common.diagonalEvolution (freeEigenvalue ξ) (-β)) ≠ 0 := by
      have hZ := grandCanonicalAlgebraicPartition_ne_zero ε β μ hpos
      simpa only [grandCanonicalAlgebraicPartition, imaginaryTimeEvolveFree] using hZ
    simpa only [grandCanonicalGibbsExpectation, grandCanonicalAlgebraicPartition,
      imaginaryTimeEvolveFree, one_mul] using
      Common.normalizedTsumTrace_comp_eq_div_of_zetaCommutator
        (freeEigenvalue ξ) β (-(ξ i)) (1 : ℂ)
        (if i = j then (1 : ℂ) else 0) (annihilate i) (create j)
        hC1 hcomm (by simpa only [imaginaryTimeEvolveFree] using hSummD)
        (by simpa only [imaginaryTimeEvolveFree] using hRotate)
        hpartition (by simpa only [one_mul] using hden)
  rw [hvalue]
  by_cases hij : i = j <;> simp [hij]

/-- Grand-canonical creation/annihilation contraction under the KMS rotation
generated by `K = H - μ N̂`, rather than physical time evolution under `H`.
This directly evaluates the finite-mode Bose occupation correlation. -/
theorem grandCanonicalGibbsExpectation_create_comp_annihilate_concrete
    (ε : Mode → ℝ) (β μ : ℝ)
    (hpos : ∀ k, 0 < β * (ε k - μ)) (i j : Mode) :
    grandCanonicalGibbsExpectation ε β μ ((create i).comp (annihilate j)) =
      if i = j then
        Complex.exp (((-(ε j - μ) * β : ℝ) : ℂ)) *
          (1 - Complex.exp (((-(ε j - μ) * β : ℝ) : ℂ)))⁻¹
      else 0 := by
  have hrotate := FreeThermalField.grandCanonicalGibbsExpectation_operator_comp_rotate
    ε β μ (.create i) (annihilate j)
  simp only [FreeThermalField.operator, FreeThermalField.kmsFactor] at hrotate
  rw [hrotate,
    grandCanonicalGibbsExpectation_annihilate_comp_create_concrete ε β μ hpos j i]
  by_cases hij : i = j
  · subst j
    have harg :
        -(β : ℂ) * ((ε i - μ : ℝ) : ℂ) =
          ((-(ε i - μ) * β : ℝ) : ℂ) := by
      push_cast
      ring
    simp only [ite_true, harg]
  · simp [hij, Ne.symm hij]


end
end Bosonic
end SecondQuantization
