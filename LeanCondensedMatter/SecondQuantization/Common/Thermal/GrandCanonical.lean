import LeanCondensedMatter.SecondQuantization.Common.Algebra.OccupationBasis
import LeanCondensedMatter.SecondQuantization.Common.CompletedSpace.Basic
import LeanCondensedMatter.QuantumTheory.Gibbs.Eigenbasis

set_option linter.style.header false

/-!
# Grand-canonical Gibbs states in the occupation basis

The free grand-canonical generator has occupation energies
`K(n) = E(n) - μ N(n)`. Its partition sum and normalized density operator
live on the *full* completed occupation Fock space.

These constructions are independent of bosonic or fermionic statistics.
Existence requires explicit Boltzmann summability over every occupation
configuration; unlike a fixed-N sector, this is not automatic for finite-mode
bosons. The existing generic pure-point Gibbs machinery owns normalization.

This is an ensemble-specific constructor: whether the counted occupation
number is a physically conserved charge must be determined by the model.
Physical time evolution is still generated by the Hamiltonian, not silently
replaced by the grand-canonical generator.
-/

namespace SecondQuantization
namespace Common

open QuantumTheory

noncomputable section

variable {Mode Config : Type*} [OccupationBasis Mode Config]

/-- Free grand-canonical energy for chemical potential `μ`: `E(n) - μ N(n)`. -/
noncomputable def grandCanonicalEnergy
    (ε : Mode → ℝ) (μ : ℝ) (n : Config) : ℝ :=
  occupationEnergy ε n - μ * (particleNumber (Mode := Mode) n : ℝ)

/-- Shifting each one-particle energy by `-μ` is exactly the
grand-canonical energy correction. -/
theorem grandCanonicalEnergy_eq_shifted
    (ε : Mode → ℝ) (μ : ℝ) (n : Config) :
    grandCanonicalEnergy ε μ n =
      occupationEnergy (fun i => ε i - μ) n := by
  exact (occupationEnergy_sub_const ε μ n).symm

/-- The grand-canonical energy of the occupation vacuum is zero. -/
@[simp]
theorem grandCanonicalEnergy_vacuum (ε : Mode → ℝ) (μ : ℝ) :
    grandCanonicalEnergy ε μ
      (OccupationBasis.vacuum (Mode := Mode) (Config := Config)) = 0 := by
  simp [grandCanonicalEnergy]

/-- The grand partition function sums over all occupation configurations. -/
noncomputable def grandCanonicalPartitionFunction
    (ε : Mode → ℝ) (β μ : ℝ) : ℝ :=
  eigenbasisPartitionFunction (grandCanonicalEnergy (Config := Config) ε μ) β

/-- The grand partition sum equals the generic occupation partition sum
evaluated at shifted one-particle energies. -/
theorem grandCanonicalPartitionFunction_eq_shifted
    (ε : Mode → ℝ) (β μ : ℝ) :
    grandCanonicalPartitionFunction (Config := Config) ε β μ =
      eigenbasisPartitionFunction
        (occupationEnergy (Config := Config) (fun i => ε i - μ)) β := by
  unfold grandCanonicalPartitionFunction eigenbasisPartitionFunction
  apply tsum_congr
  intro n
  rw [grandCanonicalEnergy_eq_shifted]

/-- Grand-canonical Boltzmann summability is equivalent to summability
for shifted one-particle energies. -/
theorem grandCanonicalGibbsSummable_iff_shifted
    (ε : Mode → ℝ) (β μ : ℝ) :
    EigenbasisGibbsSummable (grandCanonicalEnergy (Config := Config) ε μ) β ↔
      EigenbasisGibbsSummable
        (occupationEnergy (Config := Config) (fun i => ε i - μ)) β := by
  have hE :
      grandCanonicalEnergy (Config := Config) ε μ =
        occupationEnergy (Config := Config) (fun i => ε i - μ) := by
    funext n
    exact grandCanonicalEnergy_eq_shifted ε μ n
  rw [hE]

/-- Summable grand-canonical Boltzmann weights have a strictly positive
partition function. The vacuum ensures the occupation type is nonempty. -/
theorem grandCanonicalPartitionFunction_pos
    (ε : Mode → ℝ) (β μ : ℝ)
    (hsum : EigenbasisGibbsSummable (grandCanonicalEnergy (Config := Config) ε μ) β) :
    0 < grandCanonicalPartitionFunction (Config := Config) ε β μ := by
  letI : Nonempty Config :=
    ⟨OccupationBasis.vacuum (Mode := Mode) (Config := Config)⟩
  exact eigenbasisPartitionFunction_pos
    (grandCanonicalEnergy (Config := Config) ε μ) β hsum

/-- Normalized full-Fock grand-canonical Gibbs density at explicit chemical
potential `μ`. No additional finite-mode hypothesis is imposed. -/
noncomputable def grandCanonicalGibbsDensityOperator
    (ε : Mode → ℝ) (β μ : ℝ)
    (hsum : EigenbasisGibbsSummable (grandCanonicalEnergy (Config := Config) ε μ) β) :
    DensityOperator (CompletedFock Config) := by
  letI : Nonempty Config :=
    ⟨OccupationBasis.vacuum (Mode := Mode) (Config := Config)⟩
  exact eigenbasisGibbsDensityOperator
    (completedHilbertBasis (Config := Config))
    (grandCanonicalEnergy (Config := Config) ε μ) β hsum

/-- Grand-canonical Gibbs probabilities on occupation-basis vectors. -/
@[simp]
theorem grandCanonicalGibbsDensityOperator_apply_basis
    (ε : Mode → ℝ) (β μ : ℝ)
    (hsum : EigenbasisGibbsSummable (grandCanonicalEnergy (Config := Config) ε μ) β)
    (n : Config) :
    (grandCanonicalGibbsDensityOperator (Config := Config) ε β μ hsum).op
      (completedBasisState n) =
      (eigenbasisGibbsProbability
        (grandCanonicalEnergy (Config := Config) ε μ) β n : ℂ) •
        completedBasisState n := by
  letI : Nonempty Config :=
    ⟨OccupationBasis.vacuum (Mode := Mode) (Config := Config)⟩
  simpa [grandCanonicalGibbsDensityOperator, completedHilbertBasis_apply] using
    (eigenbasisGibbsDensityOperator_apply_basis
      (completedHilbertBasis (Config := Config))
      (grandCanonicalEnergy (Config := Config) ε μ) β hsum n)

/-- A simultaneous constant shift of the one-particle energy zero and
chemical potential leaves the grand-canonical energy unchanged. -/
theorem grandCanonicalEnergy_shift_invariant
    (ε : Mode → ℝ) (μ C : ℝ) (n : Config) :
    grandCanonicalEnergy (fun i => ε i + C) (μ + C) n =
      grandCanonicalEnergy ε μ n := by
  rw [grandCanonicalEnergy_eq_shifted, grandCanonicalEnergy_eq_shifted]
  congr 1
  funext i
  ring

end

end Common
end SecondQuantization
