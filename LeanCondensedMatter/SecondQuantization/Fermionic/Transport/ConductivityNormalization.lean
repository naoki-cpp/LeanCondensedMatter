set_option linter.style.header false

open scoped Matrix

/-!
# Fermionic finite-volume directional conductivity

This module applies the generic electric-field conversion and finite-volume conductivity
normalization to the directional current response generated by a uniform Peierls vector-potential
source on a finite fermionic lattice.

The concrete realization uses the full finite fermionic Fock space. Boundary conditions and geometry
are encoded by the finite site type, hopping amplitudes, and `LatticeGeometry`. No infinite-volume
trace per unit volume or electromagnetic-gauge equivalence is asserted, and the limits
`η → 0⁺` and `ω → 0` remain separate.
-/

namespace SecondQuantization
namespace Fermionic
namespace Transport

open _root_.SecondQuantization.Fermionic.Lattice
open QuantumTheory.LinearResponse QuantumTheory.Transport

noncomputable section

variable {Site E : Type*}
variable [LinearOrder Site] [Fintype Site]
variable [AddCommGroup E] [Module ℝ E]

/-- Finite-observation-time, finite-volume regularized conductivity. -/
noncomputable def finiteTimeAdiabaticDirectionalConductivity
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η T : ℝ) : ℂ :=
  finiteVolumeConductivityFromVectorPotential volume ω η
    ((boundedDirectionalResponseChannel system geometry direction K q).finiteTimeAdiabaticResponse
      (freePropagatorGroup system) system.hbar expectation ω η T)

/-- Infinite-observation-time, finite-volume regularized conductivity at fixed `ω` and `η`. -/
noncomputable def infiniteTimeAdiabaticDirectionalConductivity
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η : ℝ) : ℂ :=
  finiteVolumeConductivityFromVectorPotential volume ω η
    ((boundedDirectionalResponseChannel system geometry direction K q).infiniteTimeAdiabaticResponse
      (freePropagatorGroup system) system.hbar expectation ω η)

/-- Stationarity and `η > 0` give the observation-time limit for the explicitly normalized
finite-volume conductivity. -/
theorem hasInfiniteObservationTimeLimit_directionalConductivity_of_stationary_pos
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (hstationary : IsStationary (freePropagatorGroup system) expectation)
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η : ℝ) (hη : 0 < η) :
    HasInfiniteObservationTimeLimit
      (finiteTimeAdiabaticDirectionalConductivity volume
        system expectation geometry direction K q ω η)
      (infiniteTimeAdiabaticDirectionalConductivity volume
        system expectation geometry direction K q ω η) := by
  let channel := boundedDirectionalResponseChannel system geometry direction K q
  have hMeas := measurable_retardedTimeDifferenceKernel
    (freePropagatorGroup system) system.hbar expectation channel.measured channel.source
    (continuous_commutatorSusceptibility_timeDifference
      (freePropagatorGroup system) system.hbar expectation channel.measured channel.source
      (continuous_heisenbergEvolution system channel.measured)).measurable
  have hlimit :=
    ResponseChannel.hasInfiniteObservationTimeLimit_finiteTimeAdiabaticResponse_of_stationary_pos
      channel (freePropagatorGroup system) system.hbar expectation hstationary ω η hη hMeas
  unfold HasInfiniteObservationTimeLimit at hlimit ⊢
  change Filter.Tendsto
    (fun T : ℝ =>
      (boundedDirectionalResponseChannel system geometry direction K q).finiteTimeAdiabaticResponse
          (freePropagatorGroup system) system.hbar expectation ω η T *
        finiteVolumeConductivityNormalization volume ω η)
    Filter.atTop
    (nhds
      ((boundedDirectionalResponseChannel system geometry direction K q).infiniteTimeAdiabaticResponse
          (freePropagatorGroup system) system.hbar expectation ω η *
        finiteVolumeConductivityNormalization volume ω η))
  exact hlimit.mul
    (tendsto_const_nhds :
      Filter.Tendsto
        (fun _ : ℝ => finiteVolumeConductivityNormalization volume ω η)
        Filter.atTop
        (nhds (finiteVolumeConductivityNormalization volume ω η)))

/-- A finite affine site symmetry preserving the hopping amplitudes constrains
the physically normalized Gibbs Kubo conductivity, including the mixed Peierls
contact. The real matrix R describes pullback on the chosen directional
functionals. Neither current covariance, state invariance, dynamical invariance,
nor integrability is an independent hypothesis. The system's Hamiltonian must
be the same hopping Hamiltonian used in the current. No infinite-time or DC
limit is taken. -/
theorem finiteTimeGeometricConductivity_linearMixing
    {I : Type*} [Fintype I]
    (volume : PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (geometry : LatticeGeometry Site E) (direction : I → E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q β ω η T : ℝ) (hT : 0 ≤ T)
    (hHamiltonian : system.hamiltonian.1 = boundedHoppingHamiltonian K)
    (p : Equiv.Perm Site) (L : E →ₗ[ℝ] E) (a : E)
    (hposition : ∀ x, geometry.position (p x) = L (geometry.position x) + a)
    (hK : ∀ x y, K.amplitude (p x) (p y) = K.amplitude x y)
    (R : I → I → ℝ)
    (hDirection : ∀ i, (direction i).comp L = ∑ k, R i k • direction k) :
    let σ := finiteTimeVectorPotentialConductivityTensor (freePropagatorGroup system)
      (fun i => boundedDirectionalCurrent geometry (direction i) (system.hbar : ℂ) (q : ℂ) K)
      (fun j => boundedDirectionalCurrent geometry (direction j) (system.hbar : ℂ) (q : ℂ) K)
      (fun i j => boundedMixedDirectionalContact geometry (direction i) (direction j)
        (system.hbar : ℂ) (q : ℂ) K)
      volume system.hbar ω η T
      (QuantumTheory.gibbsState system.hamiltonian β).toNormalizedExpectation
    ∀ i j, (∑ k, ∑ l, ((R i k : ℂ) * (R j l : ℂ)) * σ.component k l) =
      σ.component i j := by
  classical
  obtain ⟨W, hUnit⟩ := exists_unitary_sitePermutation p
  let Φ := W.conjStarAlgEquiv
  let J := fun i => boundedDirectionalCurrent geometry (direction i)
    (system.hbar : ℂ) (q : ℂ) K
  let C := fun i j => boundedMixedDirectionalContact geometry (direction i) (direction j)
    (system.hbar : ℂ) (q : ℂ) K
  let ρ := QuantumTheory.gibbsState system.hamiltonian β
  have hH : Φ system.hamiltonian.1 = system.hamiltonian.1 := by
    rw [hHamiltonian]
    exact boundedHoppingHamiltonian_siteCovariance K p Φ.toAlgEquiv.toLinearMap hK hUnit
  have hHinv : Φ.symm system.hamiltonian.1 = system.hamiltonian.1 := by
    calc
      _ = Φ.symm (Φ system.hamiltonian.1) := congrArg Φ.symm hH.symm
      _ = _ := Φ.symm_apply_apply _
  have hU := freePropagatorGroup_fixed_of_hamiltonian_fixed system Φ.symm hHinv
  have hρ : Φ.symm ρ.op = ρ.op :=
    QuantumTheory.gibbsState_op_fixed_of_hamiltonian_fixed system.hamiltonian β Φ.symm hHinv
  have hω (A : FiniteLatticeHilbertFock Site →L[ℂ] FiniteLatticeHilbertFock Site) :
      ρ.toNormalizedExpectation (Φ.symm A) = ρ.toNormalizedExpectation A := by
    have hρ' : W.symm.conjStarAlgEquiv ρ.op = ρ.op := by
      simpa only [Φ, LinearIsometryEquiv.symm_conjStarAlgEquiv] using hρ
    simpa only [QuantumTheory.DensityOperator.toNormalizedExpectation_apply,
      Φ, LinearIsometryEquiv.symm_conjStarAlgEquiv] using
      ρ.expectation_conjStarAlgEquiv_of_fixed W.symm hρ' A
  have hJ (i : I) : Φ.symm (J i) = ∑ k, (R i k : ℂ) • J k := by
    have hcov := boundedDirectionalCurrent_siteCovariance geometry (direction i)
      (system.hbar : ℂ) (q : ℂ) K p L a hposition Φ.toAlgEquiv.toLinearMap hK hUnit
    change Φ (boundedDirectionalCurrent geometry ((direction i).comp L)
      (system.hbar : ℂ) (q : ℂ) K) = J i at hcov
    calc
      _ = boundedDirectionalCurrent geometry ((direction i).comp L)
          (system.hbar : ℂ) (q : ℂ) K := by
        rw [← hcov, Φ.symm_apply_apply]
      _ = _ := by
        rw [hDirection i]
        exact boundedDirectionalCurrent_sum geometry direction (R i)
          (system.hbar : ℂ) (q : ℂ) K
  have hC (i j : I) : Φ.symm (C i j) =
      ∑ k, ∑ l, ((R i k : ℂ) * (R j l : ℂ)) • C k l := by
    have hcov := boundedMixedDirectionalContact_siteCovariance geometry (direction i) (direction j)
      (system.hbar : ℂ) (q : ℂ) K p L a hposition Φ.toAlgEquiv.toLinearMap hK hUnit
    change Φ (boundedMixedDirectionalContact geometry ((direction i).comp L)
      ((direction j).comp L) (system.hbar : ℂ) (q : ℂ) K) = C i j at hcov
    calc
      _ = boundedMixedDirectionalContact geometry ((direction i).comp L)
          ((direction j).comp L) (system.hbar : ℂ) (q : ℂ) K := by
        rw [← hcov, Φ.symm_apply_apply]
      _ = _ := by
        rw [hDirection i, hDirection j]
        exact boundedMixedDirectionalContact_sum geometry direction direction (R i) (R j)
          (system.hbar : ℂ) (q : ℂ) K
  intro σ i j
  exact finiteTimeVectorPotentialConductivityTensor_linearMixing
    (freePropagatorGroup system) Φ.symm J J C
    (fun i k => (R i k : ℂ)) (fun j l => (R j l : ℂ)) hU volume
    system.hbar ω η T ρ.toNormalizedExpectation hω hJ hJ hC
    (fun k l => intervalIntegrable_finiteTimeRetardedIntegrand
      system ρ.toNormalizedExpectation (J k) (J l) ω η T hT) i j


/-- The actual species-labeled configuration point group constrains the Gibbs
Kubo conductivity when a representative configuration symmetry also preserves
the hopping amplitudes. Its site permutation comes from the existing canonical
action on occupied sites; neither an independent permutation nor a direction
transformation law is assumed. The real orthonormal coordinate matrix is that
of the linear part, including for affine representatives with translations.
The finite sample itself must be preserved, not just its ambient bulk lattice. -/
theorem finiteTimeCrystalConductivity_pointGroup
    {V Species I : Type*}
    [NormedAddCommGroup V] [InnerProductSpace ℝ V] [Fintype I]
    (X : LeanCondensedMatter.Crystal.AtomicConfiguration V Species)
    [LinearOrder X.Site] [Fintype X.Site]
    (g : X.pointGroup (V := V)) (b : OrthonormalBasis I ℝ V)
    (volume : PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock X.Site))
    (K : LocallyFiniteHopping X.Site) (q β ω η T : ℝ) (hT : 0 ≤ T)
    (hHamiltonian : system.hamiltonian.1 = boundedHoppingHamiltonian K)
    (hLift : ∃ s : X.symmetryGroup,
      X.symmetryLinearPartHom (V := V) s = (g : V ≃ₗᵢ[ℝ] V) ∧
      ∀ x y : X.Site, K.amplitude (s • x) (s • y) = K.amplitude x y) :
    let geometry : LatticeGeometry X.Site V := ⟨Subtype.val⟩
    let direction := b.toBasis.coord
    let R : Matrix I I ℝ := fun i k => direction i ((g : V ≃ₗᵢ[ℝ] V) (b k))
    let σ := finiteTimeVectorPotentialConductivityTensor (freePropagatorGroup system)
      (fun i => boundedDirectionalCurrent geometry (direction i) (system.hbar : ℂ) (q : ℂ) K)
      (fun j => boundedDirectionalCurrent geometry (direction j) (system.hbar : ℂ) (q : ℂ) K)
      (fun i j => boundedMixedDirectionalContact geometry (direction i) (direction j)
        (system.hbar : ℂ) (q : ℂ) K)
      volume system.hbar ω η T
      (QuantumTheory.gibbsState system.hamiltonian β).toNormalizedExpectation
    ∀ i j, (∑ k, ∑ l, ((R i k : ℂ) * (R j l : ℂ)) * σ.component k l) =
      σ.component i j := by
  classical
  obtain ⟨s, hs, hK⟩ := hLift
  intro geometry direction R σ
  let p := MulAction.toPermHom X.symmetryGroup X.Site s
  let L := (g : V ≃ₗᵢ[ℝ] V).toLinearEquiv.toLinearMap
  let e : V ≃ᵃⁱ[ℝ] V := (s : V ≃ᵢ V).toRealAffineIsometryEquiv
  have hL : e.linearIsometryEquiv = (g : V ≃ₗᵢ[ℝ] V) := hs
  have hposition (x : X.Site) : geometry.position (p x) =
      L (geometry.position x) + e 0 := by
    change e (x : V) = L (x : V) + e 0
    have hx := e.map_vadd (0 : V) (x : V)
    change e ((x : V) + 0) = e.linearIsometryEquiv (x : V) + e 0 at hx
    rw [add_zero, hL] at hx
    exact hx
  have hDirection (i : I) : (direction i).comp L = ∑ k, R i k • direction k := by
    apply b.toBasis.ext
    intro k
    change direction i (L (b k)) =
      (∑ j, R i j • direction j) (b.toBasis k)
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul]
    have hcoord (j : I) : direction j (b.toBasis k) = if k = j then 1 else 0 := by
      simp [direction, Module.Basis.coord_apply, Finsupp.single_apply]
    change R i k = ∑ j, R i j * direction j (b.toBasis k)
    simp only [hcoord, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, if_true]
  exact finiteTimeGeometricConductivity_linearMixing volume system geometry direction
    K q β ω η T hT hHamiltonian p L (e 0) hposition hK R hDirection

/-- An actual quarter-turn symmetry of the finite species-labeled configuration,
preserving the microscopic hopping Hamiltonian, forces equal longitudinal and
opposite off-diagonal Gibbs Kubo conductivities. A proper rotation does not
force the Hall response to vanish. -/
theorem finiteTimeCrystalConductivity_isPlanarIsotropic_of_quarterTurn
    {V Species : Type*}
    [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    (X : LeanCondensedMatter.Crystal.AtomicConfiguration V Species)
    [LinearOrder X.Site] [Fintype X.Site]
    (g : X.pointGroup (V := V)) (b : OrthonormalBasis (Fin 2) ℝ V)
    (volume : PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock X.Site))
    (K : LocallyFiniteHopping X.Site) (q β ω η T : ℝ) (hT : 0 ≤ T)
    (hHamiltonian : system.hamiltonian.1 = boundedHoppingHamiltonian K)
    (hLift : ∃ s : X.symmetryGroup,
      X.symmetryLinearPartHom (V := V) s = (g : V ≃ₗᵢ[ℝ] V) ∧
      ∀ x y : X.Site, K.amplitude (s • x) (s • y) = K.amplitude x y)
    (hQuarter : (fun i k => b.toBasis.coord i ((g : V ≃ₗᵢ[ℝ] V) (b k)) :
        Matrix (Fin 2) (Fin 2) ℝ) = !![0, -1; 1, 0]) :
    let geometry : LatticeGeometry X.Site V := ⟨Subtype.val⟩
    let direction := b.toBasis.coord
    (finiteTimeVectorPotentialConductivityTensor (freePropagatorGroup system)
      (fun i => boundedDirectionalCurrent geometry (direction i) (system.hbar : ℂ) (q : ℂ) K)
      (fun j => boundedDirectionalCurrent geometry (direction j) (system.hbar : ℂ) (q : ℂ) K)
      (fun i j => boundedMixedDirectionalContact geometry (direction i) (direction j)
        (system.hbar : ℂ) (q : ℂ) K)
      volume system.hbar ω η T
      (QuantumTheory.gibbsState system.hamiltonian β).toNormalizedExpectation).IsPlanarIsotropic := by
  classical
  intro geometry direction
  apply (ConductivityTensor.isQuarterTurnInvariant_iff_isPlanarIsotropic _).mp
  dsimp only [ConductivityTensor.IsQuarterTurnInvariant]
  intro i j
  have h := finiteTimeCrystalConductivity_pointGroup X g b volume system K q β ω η T
    hT hHamiltonian hLift i j
  dsimp only at h
  rw [hQuarter] at h
  have hcast (i k : Fin 2) :
      (((!![0, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℝ) i k : ℝ) : ℂ) =
        (!![0, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℂ) i k := by
    fin_cases i <;> fin_cases k <;> simp
  simp only [hcast] at h
  simpa only [mul_right_comm] using h

end
