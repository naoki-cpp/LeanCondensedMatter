import LeanCondensedMatter.Transport.Core.ConductivityNormalization
import LeanCondensedMatter.SecondQuantization.Fermionic.Transport.ChargeCurrentChannel
import LeanCondensedMatter.QuantumTheory.LinearResponse.Frequency.InfiniteTime

set_option linter.style.header false

/-!
# Fermionic finite-volume directional conductivity

This module applies the generic electric-field conversion and finite-volume conductivity
normalization to the directional current response generated by a uniform Peierls vector-potential
source on a finite fermionic lattice.

The concrete realization uses the full finite fermionic Fock space. Boundary conditions and geometry
are encoded by the finite site type, hopping amplitudes, and `LatticeGeometry`. No infinite-volume
trace per unit volume or electromagnetic-gauge equivalence is asserted, and the limits
`η → 0⁺` and `ω → 0` remain separate.
-/

namespace SecondQuantization
namespace Fermionic
namespace Transport

open _root_.SecondQuantization.Fermionic.Lattice
open QuantumTheory.LinearResponse QuantumTheory.Transport

noncomputable section

variable {Site E : Type*}
variable [LinearOrder Site] [Fintype Site]
variable [AddCommGroup E] [Module ℝ E]

/-- Finite-observation-time, finite-volume regularized conductivity. -/
noncomputable def finiteTimeAdiabaticDirectionalConductivity
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η T : ℝ) : ℂ :=
  finiteVolumeConductivityFromVectorPotential volume ω η
    ((boundedDirectionalResponseChannel system geometry direction K q).finiteTimeAdiabaticResponse
      (freePropagatorGroup system) system.hbar expectation ω η T)

/-- Infinite-observation-time, finite-volume regularized conductivity at fixed `ω` and `η`. -/
noncomputable def infiniteTimeAdiabaticDirectionalConductivity
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η : ℝ) : ℂ :=
  finiteVolumeConductivityFromVectorPotential volume ω η
    ((boundedDirectionalResponseChannel system geometry direction K q).infiniteTimeAdiabaticResponse
      (freePropagatorGroup system) system.hbar expectation ω η)

/-- Stationarity and `η > 0` give the observation-time limit for the explicitly normalized
finite-volume conductivity. -/
theorem hasInfiniteObservationTimeLimit_directionalConductivity_of_stationary_pos
    (volume : QuantumTheory.Transport.PositiveVolume)
    (system : BoundedFreeSystem (FiniteLatticeHilbertFock Site))
    (expectation : NormalizedExpectation (FiniteLatticeHilbertFock Site))
    (hstationary : IsStationary (freePropagatorGroup system) expectation)
    (geometry : LatticeGeometry Site E) (direction : E →ₗ[ℝ] ℝ)
    (K : LocallyFiniteHopping Site) (q ω η : ℝ) (hη : 0 < η) :
    HasInfiniteObservationTimeLimit
      (finiteTimeAdiabaticDirectionalConductivity volume
        system expectation geometry direction K q ω η)
      (infiniteTimeAdiabaticDirectionalConductivity volume
        system expectation geometry direction K q ω η) := by
  let channel := boundedDirectionalResponseChannel system geometry direction K q
  have hMeas := measurable_retardedTimeDifferenceKernel
    (freePropagatorGroup system) system.hbar expectation channel.measured channel.source
    (continuous_commutatorSusceptibility_timeDifference
      (freePropagatorGroup system) system.hbar expectation channel.measured channel.source
      (continuous_heisenbergEvolution system channel.measured)).measurable
  have hlimit :=
    ResponseChannel.hasInfiniteObservationTimeLimit_finiteTimeAdiabaticResponse_of_stationary_pos
      channel (freePropagatorGroup system) system.hbar expectation hstationary ω η hη hMeas
  unfold HasInfiniteObservationTimeLimit at hlimit ⊢
  change Filter.Tendsto
    (fun T : ℝ =>
      (boundedDirectionalResponseChannel system geometry direction K q).finiteTimeAdiabaticResponse
          (freePropagatorGroup system) system.hbar expectation ω η T *
        finiteVolumeConductivityNormalization volume ω η)
    Filter.atTop
    (nhds
      ((boundedDirectionalResponseChannel system geometry direction K q).infiniteTimeAdiabaticResponse
          (freePropagatorGroup system) system.hbar expectation ω η *
        finiteVolumeConductivityNormalization volume ω η))
  exact hlimit.mul
    (tendsto_const_nhds :
      Filter.Tendsto
        (fun _ : ℝ => finiteVolumeConductivityNormalization volume ω η)
        Filter.atTop
        (nhds (finiteVolumeConductivityNormalization volume ω η)))
end
end Transport
end Fermionic
end SecondQuantization
