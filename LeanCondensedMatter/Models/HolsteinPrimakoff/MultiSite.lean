import LeanCondensedMatter.Models.HolsteinPrimakoff
import LeanCondensedMatter.QuantumTheory.LocalizedSpin
import LeanCondensedMatter.Analysis.Operator.AlgebraRestriction
import Mathlib.LinearAlgebra.Finsupp.Supported
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

set_option linter.style.header false

/-!
# Simultaneous physical occupation sector for Holstein-Primakoff spins

Every site's occupation is bounded by 2s. For finitely many sites, the configuration
Hilbert space is identified linearly with this sector of algebraic bosonic Fock space.
The latter has no completed Hilbert-space structure here; no isometry is asserted.
The bosonic mode labels here denote localized spin sites.
-/

namespace Models.HolsteinPrimakoff

open SecondQuantization SecondQuantization.Bosonic

noncomputable section
variable {Mode : Type*}

/-- The simultaneous physical sector for uniform spin s, imposing n_i <= 2s at every site.
Stancil-Prabhakar, Section 2.7.1. -/
def simultaneousSubspace (twiceSpin : ℕ) : Submodule ℂ (FockSpace Mode) :=
  Finsupp.supported ℂ ℂ {n : Occupation Mode | ∀ i, n i ≤ twiceSpin}

private theorem physicalSubspace_eq_supported (twiceSpin : ℕ) (i : Mode) :
    physicalSubspace twiceSpin i =
      Finsupp.supported ℂ ℂ {n : Occupation Mode | n i ≤ twiceSpin} := by
  change Submodule.span ℂ ((fun n : Occupation Mode => Finsupp.single n (1 : ℂ)) ''
    {n : Occupation Mode | n i ≤ twiceSpin}) = _
  exact (Finsupp.supported_eq_span_single (R := ℂ)
    {n : Occupation Mode | n i ≤ twiceSpin}).symm

theorem simultaneousSubspace_eq_iInf (twiceSpin : ℕ) :
    simultaneousSubspace (Mode := Mode) twiceSpin = ⨅ i, physicalSubspace twiceSpin i := by
  have hs : {n : Occupation Mode | ∀ i, n i ≤ twiceSpin} =
      ⋂ i, {n : Occupation Mode | n i ≤ twiceSpin} := by ext n; simp
  unfold simultaneousSubspace
  rw [hs, Finsupp.supported_iInter]
  congr 1
  funext i
  exact (physicalSubspace_eq_supported twiceSpin i).symm

theorem simultaneousSubspace_eq_span (twiceSpin : ℕ) :
    simultaneousSubspace (Mode := Mode) twiceSpin =
      Submodule.span ℂ (basisState '' {n : Occupation Mode | ∀ i, n i ≤ twiceSpin}) := by
  change Finsupp.supported ℂ ℂ {n : Occupation Mode | ∀ i, n i ≤ twiceSpin} =
    Submodule.span ℂ ((fun n : Occupation Mode => Finsupp.single n (1 : ℂ)) '' _)
  exact Finsupp.supported_eq_span_single (R := ℂ)
    {n : Occupation Mode | ∀ i, n i ≤ twiceSpin}

private theorem basisState_mem_simultaneousSubspace (twiceSpin : ℕ) (n : Occupation Mode)
    (hn : ∀ i, n i ≤ twiceSpin) : basisState n ∈ simultaneousSubspace twiceSpin := by
  rw [simultaneousSubspace_eq_span]
  exact Submodule.subset_span ⟨n, hn, rfl⟩

private theorem preserves_simultaneousSubspace (twiceSpin : ℕ)
    (A : FockSpace Mode →ₗ[ℂ] FockSpace Mode)
    (hA : ∀ n : Occupation Mode, (∀ i, n i ≤ twiceSpin) →
      A (basisState n) ∈ simultaneousSubspace twiceSpin)
    (ψ : FockSpace Mode) (hψ : ψ ∈ simultaneousSubspace twiceSpin) :
    A ψ ∈ simultaneousSubspace twiceSpin := by
  have h : simultaneousSubspace twiceSpin ≤ (simultaneousSubspace twiceSpin).comap A := by
    conv_lhs => rw [simultaneousSubspace_eq_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨n, hn, rfl⟩
    exact hA n hn
  exact h hψ

private theorem spinPlus_mem_simultaneousSubspace (hbar : ℝ) (twiceSpin : ℕ) (i : Mode)
    (ψ : FockSpace Mode) (hψ : ψ ∈ simultaneousSubspace twiceSpin) :
    spinPlus hbar twiceSpin i ψ ∈ simultaneousSubspace twiceSpin := by
  apply preserves_simultaneousSubspace twiceSpin _ _ ψ hψ
  intro n hn
  rw [spinPlus_basisState]
  apply Submodule.smul_mem
  apply basisState_mem_simultaneousSubspace
  intro j
  by_cases hj : j = i
  · subst j
    simp only [removeOccupation_apply_same]
    exact (Nat.sub_le _ _).trans (hn i)
  · simpa only [removeOccupation_apply_ne hj] using hn j

private theorem spinMinus_mem_simultaneousSubspace (hbar : ℝ) (twiceSpin : ℕ) (i : Mode)
    (ψ : FockSpace Mode) (hψ : ψ ∈ simultaneousSubspace twiceSpin) :
    spinMinus hbar twiceSpin i ψ ∈ simultaneousSubspace twiceSpin := by
  apply preserves_simultaneousSubspace twiceSpin _ _ ψ hψ
  intro n hn
  by_cases ht : n i = twiceSpin
  · rw [spinMinus_basisState_of_top hbar twiceSpin i n ht]
    exact Submodule.zero_mem _
  · rw [spinMinus_basisState]
    apply Submodule.smul_mem
    apply basisState_mem_simultaneousSubspace
    intro j
    by_cases hj : j = i
    · subst j
      simp only [createOccupation_apply_same]
      have := hn i
      omega
    · simpa only [createOccupation_apply_ne hj] using hn j

private theorem spinZ_mem_simultaneousSubspace (hbar : ℝ) (twiceSpin : ℕ) (i : Mode)
    (ψ : FockSpace Mode) (hψ : ψ ∈ simultaneousSubspace twiceSpin) :
    spinZ hbar twiceSpin i ψ ∈ simultaneousSubspace twiceSpin := by
  apply preserves_simultaneousSubspace twiceSpin _ _ ψ hψ
  intro n hn
  rw [spinZ_basisState]
  exact Submodule.smul_mem _ _ (basisState_mem_simultaneousSubspace twiceSpin n hn)

/-- The unital complex algebra generated by the local spin ladder and longitudinal
operators. Its elements include local spin polynomials and linear combinations. -/
def spinAlgebra (hbar : ℝ) (twiceSpin : ℕ) (i : Mode) :
    Subalgebra ℂ (FockSpace Mode →ₗ[ℂ] FockSpace Mode) :=
  Algebra.adjoin ℂ {spinPlus hbar twiceSpin i, spinMinus hbar twiceSpin i, spinZ hbar twiceSpin i}

/-- Every element of a local spin algebra preserves the simultaneous physical sector. -/
theorem mem_simultaneousSubspace_of_mem_spinAlgebra (hbar : ℝ) (twiceSpin : ℕ) (i : Mode)
    (A : FockSpace Mode →ₗ[ℂ] FockSpace Mode) (hA : A ∈ spinAlgebra hbar twiceSpin i)
    (ψ : FockSpace Mode) (hψ : ψ ∈ simultaneousSubspace twiceSpin) :
    A ψ ∈ simultaneousSubspace twiceSpin := by
  induction hA using Algebra.adjoin_induction generalizing ψ with
  | mem A hA =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl
    · exact spinPlus_mem_simultaneousSubspace hbar twiceSpin i ψ hψ
    · exact spinMinus_mem_simultaneousSubspace hbar twiceSpin i ψ hψ
    · exact spinZ_mem_simultaneousSubspace hbar twiceSpin i ψ hψ
  | algebraMap c =>
    change c • ψ ∈ simultaneousSubspace twiceSpin
    exact Submodule.smul_mem _ c hψ
  | add A B _ _ hA hB =>
    exact Submodule.add_mem _ (hA ψ hψ) (hB ψ hψ)
  | mul A B _ _ hA hB =>
    exact hA (B ψ) (hB ψ hψ)

private theorem spinPlus_comm_spinPlus (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j) : Commute (spinPlus hbar twiceSpin i) (spinPlus hbar twiceSpin j) := by
  change (spinPlus hbar twiceSpin i).comp (spinPlus hbar twiceSpin j) =
    (spinPlus hbar twiceSpin j).comp (spinPlus hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinPlus hbar twiceSpin i (spinPlus hbar twiceSpin j (basisState n)) =
    spinPlus hbar twiceSpin j (spinPlus hbar twiceSpin i (basisState n))
  simp only [spinPlus_basisState, map_smul, removeOccupation_apply_ne hij,
    removeOccupation_apply_ne hij.symm, smul_smul, removeOccupation_comm hij]
  congr 1
  ring

private theorem spinMinus_comm_spinMinus (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j) : Commute (spinMinus hbar twiceSpin i) (spinMinus hbar twiceSpin j) := by
  change (spinMinus hbar twiceSpin i).comp (spinMinus hbar twiceSpin j) =
    (spinMinus hbar twiceSpin j).comp (spinMinus hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinMinus hbar twiceSpin i (spinMinus hbar twiceSpin j (basisState n)) =
    spinMinus hbar twiceSpin j (spinMinus hbar twiceSpin i (basisState n))
  simp only [spinMinus_basisState, map_smul, createOccupation_apply_ne hij,
    createOccupation_apply_ne hij.symm, smul_smul, createOccupation_comm i j]
  congr 1
  ring

private theorem spinPlus_comm_spinMinus (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j) : Commute (spinPlus hbar twiceSpin i) (spinMinus hbar twiceSpin j) := by
  change (spinPlus hbar twiceSpin i).comp (spinMinus hbar twiceSpin j) =
    (spinMinus hbar twiceSpin j).comp (spinPlus hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinPlus hbar twiceSpin i (spinMinus hbar twiceSpin j (basisState n)) =
    spinMinus hbar twiceSpin j (spinPlus hbar twiceSpin i (basisState n))
  simp only [spinPlus_basisState, spinMinus_basisState, map_smul,
    createOccupation_apply_ne hij, removeOccupation_apply_ne hij.symm, smul_smul,
    removeOccupation_createOccupation_of_ne hij]
  congr 1
  ring

private theorem spinZ_comm_spinPlus (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j) : Commute (spinZ hbar twiceSpin i) (spinPlus hbar twiceSpin j) := by
  change (spinZ hbar twiceSpin i).comp (spinPlus hbar twiceSpin j) =
    (spinPlus hbar twiceSpin j).comp (spinZ hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinZ hbar twiceSpin i (spinPlus hbar twiceSpin j (basisState n)) =
    spinPlus hbar twiceSpin j (spinZ hbar twiceSpin i (basisState n))
  simp only [spinZ_basisState, spinPlus_basisState, map_smul,
    removeOccupation_apply_ne hij, smul_smul]
  congr 1
  ring

private theorem spinZ_comm_spinMinus (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j) : Commute (spinZ hbar twiceSpin i) (spinMinus hbar twiceSpin j) := by
  change (spinZ hbar twiceSpin i).comp (spinMinus hbar twiceSpin j) =
    (spinMinus hbar twiceSpin j).comp (spinZ hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinZ hbar twiceSpin i (spinMinus hbar twiceSpin j (basisState n)) =
    spinMinus hbar twiceSpin j (spinZ hbar twiceSpin i (basisState n))
  simp only [spinZ_basisState, spinMinus_basisState, map_smul,
    createOccupation_apply_ne hij, smul_smul]
  congr 1
  ring

private theorem spinZ_comm_spinZ (hbar : ℝ) (twiceSpin : ℕ) (i j : Mode) :
    Commute (spinZ hbar twiceSpin i) (spinZ hbar twiceSpin j) := by
  change (spinZ hbar twiceSpin i).comp (spinZ hbar twiceSpin j) =
    (spinZ hbar twiceSpin j).comp (spinZ hbar twiceSpin i)
  apply Common.linearMap_ext_basisState
  intro n
  change spinZ hbar twiceSpin i (spinZ hbar twiceSpin j (basisState n)) =
    spinZ hbar twiceSpin j (spinZ hbar twiceSpin i (basisState n))
  simp only [spinZ_basisState, map_smul, smul_smul]
  congr 1
  ring

/-- Distinct sites' local spin algebras commute, including all local spin polynomials.
This holds on the ambient algebraic Fock space and hence on its physical sector. -/
theorem commute_of_mem_spinAlgebra (hbar : ℝ) (twiceSpin : ℕ) {i j : Mode} (hij : i ≠ j)
    {A B : FockSpace Mode →ₗ[ℂ] FockSpace Mode}
    (hA : A ∈ spinAlgebra hbar twiceSpin i) (hB : B ∈ spinAlgebra hbar twiceSpin j) :
    Commute A B := by
  have hgen : ∀ a ∈ ({spinPlus hbar twiceSpin i, spinMinus hbar twiceSpin i,
      spinZ hbar twiceSpin i} : Set (FockSpace Mode →ₗ[ℂ] FockSpace Mode)),
      ∀ b ∈ ({spinPlus hbar twiceSpin j, spinMinus hbar twiceSpin j,
      spinZ hbar twiceSpin j} : Set (FockSpace Mode →ₗ[ℂ] FockSpace Mode)), Commute a b := by
    intro a ha b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl
    · exact spinPlus_comm_spinPlus hbar twiceSpin hij
    · exact spinPlus_comm_spinMinus hbar twiceSpin hij
    · exact (spinZ_comm_spinPlus hbar twiceSpin hij.symm).symm
    · exact (spinPlus_comm_spinMinus hbar twiceSpin hij.symm).symm
    · exact spinMinus_comm_spinMinus hbar twiceSpin hij
    · exact (spinZ_comm_spinMinus hbar twiceSpin hij.symm).symm
    · exact spinZ_comm_spinPlus hbar twiceSpin hij
    · exact spinZ_comm_spinMinus hbar twiceSpin hij
    · exact spinZ_comm_spinZ hbar twiceSpin i j
  apply Algebra.commute_of_mem_adjoin_of_forall_mem_commute hB
  intro b hb
  exact (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hA
    (fun a ha => (hgen a ha b hb).symm)).symm

section FiniteSites
variable [Fintype Mode]

/-- Convert finite spin configurations to bounded bosonic occupations and back. -/
def configurationEquivOccupation (twiceSpin : ℕ) :
    QuantumTheory.LocalizedSpin.Configuration twiceSpin Mode ≃
      {n : Occupation Mode // ∀ i, n i ≤ twiceSpin} where
  toFun c := ⟨Finsupp.equivFunOnFinite.symm (fun i => (c i).val), fun i => by
    simpa using Nat.le_of_lt_succ (c i).isLt⟩
  invFun n i := ⟨n.val i, Nat.lt_succ_of_le (n.property i)⟩
  left_inv c := by funext i; apply Fin.ext; simp
  right_inv n := by apply Subtype.ext; ext i; simp

/-- A basis-preserving complex-linear equivalence from the full finite-spin state
space to the simultaneous physical Fock sector. This is an algebraic identification. -/
def spinStateEquiv (twiceSpin : ℕ) :
    QuantumTheory.LocalizedSpin.State twiceSpin Mode ≃ₗ[ℂ]
      simultaneousSubspace (Mode := Mode) twiceSpin :=
  (WithLp.linearEquiv 2 ℂ (QuantumTheory.LocalizedSpin.Configuration twiceSpin Mode → ℂ)).trans
    ((Finsupp.linearEquivFunOnFinite ℂ ℂ _).symm.trans
      ((Finsupp.domLCongr (configurationEquivOccupation twiceSpin)).trans
        (Finsupp.supportedEquivFinsupp
          {n : Occupation Mode | ∀ i, n i ≤ twiceSpin}).symm))

theorem spinStateEquiv_single (twiceSpin : ℕ)
    (c : QuantumTheory.LocalizedSpin.Configuration twiceSpin Mode) :
    (spinStateEquiv twiceSpin (EuclideanSpace.single c 1) : FockSpace Mode) =
      basisState (configurationEquivOccupation twiceSpin c).val := by
  classical
  change ((Finsupp.supportedEquivFinsupp
    {n : Occupation Mode | ∀ i, n i ≤ twiceSpin}).symm
      ((Finsupp.domLCongr (configurationEquivOccupation twiceSpin))
        ((Finsupp.linearEquivFunOnFinite ℂ ℂ _).symm (Pi.single c 1))) : FockSpace Mode) = _
  rw [Finsupp.linearEquivFunOnFinite_symm_single, Finsupp.domLCongr_single,
    Finsupp.supportedEquivFinsupp_symm_single]
  rfl

/-- The exact action of the local HP spin algebra on the full finite-spin state space.
Restriction to the all-site physical sector precedes transport through the state equivalence. -/
def spinRepresentation (hbar : ℝ) (twiceSpin : ℕ) (i : Mode) :
    spinAlgebra hbar twiceSpin i →ₐ[ℂ]
      Module.End ℂ (QuantumTheory.LocalizedSpin.State twiceSpin Mode) :=
  ((spinStateEquiv (Mode := Mode) twiceSpin).symm.conjAlgEquiv ℂ).toAlgHom.comp
    ((spinAlgebra hbar twiceSpin i).restrictEnd (simultaneousSubspace twiceSpin)
      (fun A hA ψ hψ => mem_simultaneousSubspace_of_mem_spinAlgebra hbar twiceSpin i A hA ψ hψ))

/-- The state identification intertwines the finite-spin action with the original
bosonic operator, including products and linear combinations in the local spin algebra. -/
theorem spinRepresentation_intertwines (hbar : ℝ) (twiceSpin : ℕ) (i : Mode)
    (A : spinAlgebra hbar twiceSpin i)
    (ψ : QuantumTheory.LocalizedSpin.State twiceSpin Mode) :
    (spinStateEquiv twiceSpin (spinRepresentation hbar twiceSpin i A ψ) : FockSpace Mode) =
      A.val (spinStateEquiv twiceSpin ψ) := by
  change ((spinStateEquiv twiceSpin) ((spinStateEquiv twiceSpin).symm
    ((A.val.restrict (fun ψ hψ =>
      mem_simultaneousSubspace_of_mem_spinAlgebra hbar twiceSpin i A.val A.property ψ hψ))
        (spinStateEquiv twiceSpin ψ))) : FockSpace Mode) = _
  rw [LinearEquiv.apply_symm_apply]
  rfl

/-- The transported local algebras commute on the finite-spin state space at distinct sites. -/
theorem commute_spinRepresentation_of_ne (hbar : ℝ) (twiceSpin : ℕ)
    {i j : Mode} (hij : i ≠ j)
    (A : spinAlgebra hbar twiceSpin i) (B : spinAlgebra hbar twiceSpin j) :
    Commute (spinRepresentation hbar twiceSpin i A)
      (spinRepresentation hbar twiceSpin j B) := by
  change (spinRepresentation hbar twiceSpin i A).comp
    (spinRepresentation hbar twiceSpin j B) =
      (spinRepresentation hbar twiceSpin j B).comp (spinRepresentation hbar twiceSpin i A)
  apply LinearMap.ext
  intro ψ
  apply (spinStateEquiv twiceSpin).injective
  apply Subtype.ext
  change (spinStateEquiv twiceSpin
    (spinRepresentation hbar twiceSpin i A (spinRepresentation hbar twiceSpin j B ψ)) :
      FockSpace Mode) =
    (spinStateEquiv twiceSpin
      (spinRepresentation hbar twiceSpin j B (spinRepresentation hbar twiceSpin i A ψ)) :
        FockSpace Mode)
  simp_rw [spinRepresentation_intertwines]
  exact LinearMap.congr_fun
    (commute_of_mem_spinAlgebra hbar twiceSpin hij A.property B.property).eq
      (spinStateEquiv twiceSpin ψ)

end FiniteSites

end
end Models.HolsteinPrimakoff
