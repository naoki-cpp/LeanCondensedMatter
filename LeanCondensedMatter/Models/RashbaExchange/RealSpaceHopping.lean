import LeanCondensedMatter.Models.RashbaExchange.Model
import LeanCondensedMatter.QuantumTheory.SpinfulLattice
import LeanCondensedMatter.SecondQuantization.Fermionic.Lattice.BoundedMatrixUnitAdjoint

set_option linter.style.header false

/-!
# Finite real-space Rashba-exchange hopping on arbitrary planar geometries

Spatial sites and positions are independent of connectivity. A directed bond
table supplies optional pairs of real coefficients (t, c), where c multiplies
the physical displacement d = r_target - r_source:

```text
T(d) = -t I + i c (d_y σ_x - d_x σ_y).
```

Each undirected bond is normally supplied in one orientation; the reverse
amplitude is generated by adjoint. If both orientations are supplied, both
contributions are added. Self-bonds are ignored and onsite energies and
exchange splittings are separate real site-dependent inputs.

The rectangular square lattice below is one specialization. Its coefficients
are t = ℏ²/(2ma²), c = ℏ α_R/(2a²), and onsite energy 4t.
The signs use exp(i p · r / ℏ). Neither continuum equivalence for arbitrary
geometries nor a periodic-boundary position operator is asserted.
-/

namespace QuantumTheory.Models.RashbaExchange

open QuantumTheory.SpinfulLattice
open SecondQuantization.Fermionic.Lattice

noncomputable section

/-- Rashba bond block for arbitrary planar displacement, using target minus source. -/
def rashbaBondBlock (t soc dx dy : ℝ) : InternalSpace.PauliMatrix :=
  (-(t : ℂ)) • (1 : InternalSpace.PauliMatrix) +
    (Complex.I * ((soc * dy : ℝ) : ℂ)) • InternalSpace.pauliX -
    (Complex.I * ((soc * dx : ℝ) : ℂ)) • InternalSpace.pauliY

variable {Site : Type*}

/-- Forward contribution. Bond coefficients have units of energy and
energy per length respectively. Half of the real onsite block is included
so that adding the adjoint restores the full onsite energy. -/
def realSpaceRashbaForwardAmplitude [DecidableEq Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) (x y : SpinfulSite Site) : ℂ :=
  let u := (ofLex x).1
  let v := (ofLex y).1
  let a := (ofLex x).2
  let b := (ofLex y).2
  if u = v then
    (((onsite u / 2 : ℝ) : ℂ) • (1 : InternalSpace.PauliMatrix) +
      ((exchange u / 2 : ℝ) : ℂ) • InternalSpace.pauliZ) a b
  else
    match bond u v with
    | none => 0
    | some (t, soc) =>
      let d := geometry.position u - geometry.position v
      rashbaBondBlock t soc d.1 d.2 a b

/-- The full amplitude is the forward table plus its adjoint. -/
def realSpaceRashbaAmplitude [DecidableEq Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) (x y : SpinfulSite Site) : ℂ :=
  realSpaceRashbaForwardAmplitude geometry bond onsite exchange x y +
    star (realSpaceRashbaForwardAmplitude geometry bond onsite exchange y x)

/-- Hermiticity does not depend on the lattice geometry or bond selection. -/
theorem star_realSpaceRashbaAmplitude [DecidableEq Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) (x y : SpinfulSite Site) :
    star (realSpaceRashbaAmplitude geometry bond onsite exchange x y) =
      realSpaceRashbaAmplitude geometry bond onsite exchange y x := by
  simp only [realSpaceRashbaAmplitude, star_add, star_star, add_comm]

/-- The existing finite hopping abstraction, with support taken from the
actual amplitude table. The corresponding geometry is `spinfulGeometry geometry`. -/
noncomputable def realSpaceRashbaHopping [Fintype Site] [DecidableEq Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) : LocallyFiniteHopping (SpinfulSite Site) :=
  LocallyFiniteHopping.ofFiniteAmplitudes (realSpaceRashbaAmplitude geometry bond onsite exchange)

/-- Hermitian amplitudes for arbitrary finite planar geometry. -/
theorem realSpaceRashbaHopping_hasHermitianAmplitudes [Fintype Site] [DecidableEq Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) :
    (realSpaceRashbaHopping geometry bond onsite exchange).HasHermitianAmplitudes := by
  intro x y
  simpa only [realSpaceRashbaHopping, LocallyFiniteHopping.ofFiniteAmplitudes_amplitude]
    using star_realSpaceRashbaAmplitude geometry bond onsite exchange x y

/-- The full finite Fock Hamiltonian is self-adjoint for any such planar lattice. -/
theorem realSpaceRashbaHamiltonian_isSelfAdjoint [Fintype Site] [LinearOrder Site]
    (geometry : LatticeGeometry Site (ℝ × ℝ))
    (bond : Site → Site → Option (ℝ × ℝ))
    (onsite exchange : Site → ℝ) :
    IsSelfAdjoint (boundedHoppingHamiltonian (realSpaceRashbaHopping geometry bond onsite exchange)) :=
  isSelfAdjoint_boundedHoppingHamiltonian _
    (realSpaceRashbaHopping_hasHermitianAmplitudes geometry bond onsite exchange)

/-! ## Open rectangular square-lattice specialization -/

/-- Spatial labels of a finite open rectangle. -/
abbrev RectangularSite (nx ny : ℕ) := Fin nx ×ₗ Fin ny

/-- Cartesian geometry of the square lattice. -/
def rectangularGeometry (nx ny : ℕ) (spacing : ℝ) :
    LatticeGeometry (RectangularSite nx ny) (ℝ × ℝ) where
  position x := (spacing * ((ofLex x).1.val : ℝ), spacing * ((ofLex x).2.val : ℝ))

/-- Positive-direction nearest-neighbor bonds only, with no wraparound.
The generic hopping constructor supplies their reverse adjoints. -/
def rectangularRashbaBonds {nx ny : ℕ}
    (params : HamiltonianParameters) (hbar spacing : ℝ)
    (x y : RectangularSite nx ny) : Option (ℝ × ℝ) :=
  let u := ofLex x
  let v := ofLex y
  if (u.1.val = v.1.val + 1 ∧ u.2 = v.2) ∨
      (u.1 = v.1 ∧ u.2.val = v.2.val + 1) then
    some (hbar ^ 2 / (2 * params.effectiveMass * spacing ^ 2),
      hbar * params.rashbaVelocity / (2 * spacing ^ 2))
  else none

/-- Square-lattice finite-difference model as a specialization of the
geometry-independent construction. Physical applications take positive
mass, spacing and ℏ. -/
noncomputable def rectangularRashbaHopping (nx ny : ℕ)
    (params : HamiltonianParameters) (hbar spacing : ℝ) :
    LocallyFiniteHopping (SpinfulSite (RectangularSite nx ny)) :=
  realSpaceRashbaHopping (rectangularGeometry nx ny spacing)
    (rectangularRashbaBonds params hbar spacing)
    (fun _ => 2 * hbar ^ 2 / (params.effectiveMass * spacing ^ 2))
    (fun _ => params.exchangeSplitting)

end
end QuantumTheory.Models.RashbaExchange
